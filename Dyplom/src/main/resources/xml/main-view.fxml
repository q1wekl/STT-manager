<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.MainController">

    <!-- Верх -->
    <top>
        <Label prefHeight="30.0" prefWidth="85.0" text="Мій застосунок" BorderPane.alignment="CENTER" />
    </top>

    <!-- Центр -->
    <center>
        <VBox alignment="CENTER" prefHeight="570.0" prefWidth="620.0" spacing="10" />
    </center>
   <right>
      <TextArea fx:id="resultText" editable="false" prefHeight="571.0" prefWidth="424.0" wrapText="true" BorderPane.alignment="CENTER" />
   </right>
   <left>
      <VBox alignment="CENTER" prefHeight="500.0" prefWidth="200.0" spacing="10.0">
         <children>
            <ComboBox fx:id="languageComboBox" prefWidth="150.0" promptText="Мова" visibleRowCount="5" />
            <ComboBox fx:id="modelTypeComboBox" prefWidth="150.0" promptText="Тип моделі" visibleRowCount="5" />
               <Button fx:id="fileSelectionButton" onAction="#handleOpenFile" text="Обрати файл" />
               <Button fx:id="speechToTextButton" onAction="#speechToText" text="Перетворити Аудіо в файл" />
         </children>
      </VBox>
   </left>

</BorderPane>
